<?xml version='1.0' encoding='utf-8'?>
<component type="desktop">
    <id>com.ayugram.desktop</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>AyuGram Desktop</name>
    <summary>A powerful Telegram fork with Ghost Mode and Anti-Recall</summary>
    <description>
        <p>AyuGram Desktop is a specialized version of the Telegram messaging app. This is an unofficial Debian/Ubuntu build, providing an easy way to install AyuGram on Debian-based systems.</p>
        <ul>
            <li>Ghost Mode and Anti-Recall features included from upstream.</li>
            <li>Optimized for Debian/Ubuntu environments.</li>
            <li>Proper system dock and icon integration (StartupWMClass fix).</li>
        </ul>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <update_contact>helpdesk_at_radolyn.com</update_contact>
    <developer_name>AyuGram Authors (Packaged by Safwan Ehfaz Saad)</developer_name>
    <url type="homepage">https://ayugram.one/</url>
    <url type="bugtracker">https://github.com/AyuGram/AyuGramDesktop/issues</url>
    <url type="translate">https://crowdin.com/project/ayugram</url>
    <url type="contribute">https://github.com/AyuGram/AyuGramDesktop/blob/dev/.github/CONTRIBUTING.md</url>
    <screenshot>
      <screenshot type="default">
        <caption>Main interface of AyuGram Desktop</caption>
        <image>https://raw.githubusercontent.com/safwanehfaz/AyuGramDesktop-Linux/dev/docs/assets/preview.png</image>
      </screenshot>
    </screenshot>
    <keywords>
        <keyword>tg</keyword>
        <keyword>telegram</keyword>
        <keyword>tdesktop</keyword>
        <keyword>messaging</keyword>
        <keyword>messenger</keyword>
        <keyword>chat</keyword>
        <keyword>ayugram</keyword>
    </keywords>
    <requires>
        <display_length compare="ge">medium</display_length>
        <internet>always</internet>
    </requires>
    <supports>
        <control>pointing</control>
        <control>keyboard</control>
        <control>touch</control>
    </supports>
    <content_rating type="oars-1.1" />
    <launchable type="desktop-id">com.ayugram.desktop.desktop</launchable>
    <provides>
        <binary>ayugram-desktop</binary>
    </provides>
    <releases>
        <release version="6.3.10" date="2026-01-09">
            <description>
                <p>Unofficial Debian package build. Focused on system integration and ease of installation for Linux users.</p>
                <p>Upstream changes:</p>
                <ul>
                    <li> Support premium emoji for non-premium users (visible to other AyuGram/exteraGram users).</li>
                    <li> View user registration &amp; chat join dates.</li>
                    <li> Crash fixes.</li>
                </ul>
                <p> Build changes:</p>
                <ul>
                    <li> Updated to latest AyuGram Desktop 6.3.10 source.</li>
                    <li> Optimized for Debian/Ubuntu(x64) environments.</li>
                    <li> Ensured proper system dock and icon integration (StartupWMClass fix).</li>
                </ul>
                <p> Note: This package is maintained by Safwan Ehfaz Saad and is not officially endorsed by the AyuGram team.</p>
            </description>
        </release>
    </releases>
</component>
